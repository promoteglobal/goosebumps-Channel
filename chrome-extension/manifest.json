{
  "manifest_version": 3,
  "name": "Goosebumps Channel - Suno Helper",
  "version": "1.6",
  "description": "Auto-opens Suno, pastes your frisson prompt, downloads to the right genre folder, and (optionally) pushes to GitHub",
  "permissions": ["storage", "tabs", "downloads"],
  "host_permissions": [
    "https://promoteglobal.github.io/*",
    "https://suno.com/*",
    "https://*.suno.ai/*",
    "https://api.github.com/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://promoteglobal.github.io/goosebumps-Channel/*"],
      "js": ["content-website.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://suno.com/*"],
      "js": ["content-suno.js"],
      "run_at": "document_idle"
    }
  ]
}
