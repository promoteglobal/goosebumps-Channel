{
  "manifest_version": 3,
  "name": "Goosebumps Channel - Suno Helper",
  "version": "1.1",
  "description": "Auto-opens Suno, pastes your frisson prompt, and downloads to the right genre folder",
  "permissions": ["storage", "tabs", "downloads"],
  "host_permissions": [
    "https://promoteglobal.github.io/*",
    "https://suno.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://promoteglobal.github.io/goosebumps-Channel/*"],
      "js": ["content-website.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://suno.com/*"],
      "js": ["content-suno.js"],
      "run_at": "document_idle"
    }
  ]
}
